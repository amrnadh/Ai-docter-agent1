# ─────────────────────────────────────────────────────────────
# MedSage BACKEND env (copy to .env in the repo root).
# In production these go into the backend host's secrets
# (python3 backend/push_spaces_to_hf.py api --secrets copies them).
# ─────────────────────────────────────────────────────────────

# Postgres (Supabase → Project Settings → Database → Session pooler URI)
DATABASE_URL=postgresql://postgres.ntlbyblfpbynasexkxdq:dkbV$AMY,5_R/v*@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Clerk (dashboard → API Keys). The backend only trusts tokens from the
# instance encoded in the publishable key. CLERK_ISSUER overrides it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Google AI Studio key (both names are read; they can hold the same key)
GEMINI_API_KEY=xxx
GOOGLE_API_KEY=xxx
# Optional overrides when Google retires a model
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq (console.groq.com) – routing, chat, report analysis
GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=llama-3.3-70b-versatile

# Tavily web search (app.tavily.com)
TAVILY_API_KEY=tvly-xxx

# Optional: ElevenLabs TTS (falls back to browser speech if unset)
ELEVEN_LABS_API_KEY=

# Hugging Face: token only needed if the model Spaces are private
HUGGINGFACE_TOKEN=
HF_PYTORCH_SPACE_URL=https://amar-nadh-medsage-pytorch.hf.space
HF_TENSORFLOW_SPACE_URL=https://amar-nadh-medsage-tensorflow.hf.space

# The backend's own public origin, used in RAG citation links
PUBLIC_API_URL=http://localhost:8000

# Extra allowed frontend origins, comma-separated (localhost is built in)
CORS_ORIGINS=https://medsage-ai.vercel.app
